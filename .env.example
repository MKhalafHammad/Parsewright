# Parsewright environment template.
# Copy to .env (`make setup` does this) and replace every placeholder.
# .env is git-ignored; never commit it and never put real values in this file.

# --- LLM (Meta Model API or self-hosted Muse Spark Open) ---

# Required. API key for the Meta Model API. Get it from your Meta developer
# account's API keys page. Not needed by Splunk or PostgreSQL.
LLM_API_KEY=your-meta-api-key-here

# Required. OpenAI-compatible base URL. Default is the public Meta Model API.
# For on-prem mode point it at your self-hosted Muse Spark Open endpoint,
# e.g. https://llm.example.com/v1, so logs never leave your network.
LLM_BASE_URL=https://api.meta.ai/v1

# Required. Model name sent to the endpoint above.
LLM_MODEL=muse-spark-1.3

# --- Splunk Enterprise (docker-compose service "splunk") ---

# Required. Setting this means YOU accept the Splunk Enterprise license.
SPLUNK_START_ARGS=--accept-license

# Required by Splunk 10.x images. Setting this means YOU accept the
# Splunk General Terms (https://www.splunk.com/en_us/legal/splunk-general-terms.html).
SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com

# Required. Password for the Splunk "admin" user, created on first start.
# At least 8 characters. `make env` (or `make up`) replaces this placeholder with a random one.
SPLUNK_PASSWORD=changeme-to-a-long-password

# Optional. Host port for Splunk Web (bound to 127.0.0.1). Default 8000.
SPLUNK_WEB_PORT=8000

# Required for the engine, the CLI and the Phase 1 probes. Splunk REST
# management host and port. Inside docker-compose the engine uses "splunk".
# From your machine, use the lab VM's address (8089 is not published by
# docker-compose; see docs/lab-findings.md). Use a placeholder like
# splunk.example.com here, never a real hostname or IP.
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089

# Required for the install probe and the deploy step. A directory that the
# engine writes add-on packages (.tgz) into and splunkd can read, at the
# same path on the Splunk host (docs/lab-findings.md, Q6).
PARSEWRIGHT_PACKAGES_DIR=/opt/parsewright/packages

# Required for the install probe and the engine. The one shared test index
# every test ingest goes to; jobs and attempts are told apart by sourcetype.
# Must start with pw_. Create it once in Splunk Web (docs/lab-findings.md, Q9).
PARSEWRIGHT_TEST_INDEX=pw_test

# Optional. Token ceiling per run (prompt + output, reasoning included). The run
# stops when it is reached. Default 300000.
PARSEWRIGHT_RUN_TOKEN_CEILING=300000

# Splunk REST tokens for the three service accounts (see docs/design.md,
# "Splunk service accounts"). With the Docker stack, `make up` creates the accounts and
# writes fresh tokens here; leave the placeholders. With your own Splunk, create them in
# Splunk Web (docs/lab-findings.md, "Lab setup") and paste them here.
SPLUNK_SEARCH_TOKEN=your-parsewright-search-token-here
SPLUNK_DEPLOY_TOKEN=your-parsewright-deploy-token-here
SPLUNK_DRIFT_TOKEN=your-parsewright-drift-token-here

# --- PostgreSQL (docker-compose service "postgres", published on localhost only) ---

# Required. Database name, user and password created on first start. Use letters and digits
# only for both passwords: docker-compose puts them into connection URLs. `make env` replaces
# the placeholders with random ones.
POSTGRES_DB=parsewright
POSTGRES_USER=parsewright
POSTGRES_PASSWORD=changeme-to-a-long-password

# Required. Password for the engine's limited database role (parsewright_app), which can
# append to the ledger but never alter, truncate or disable its protection. Set by
# `parsewright migrate`; the owner account above is used only for migrations.
POSTGRES_APP_PASSWORD=changeme-to-another-long-password

# Optional. Where the CLI on the host reaches PostgreSQL. docker-compose publishes it on
# 127.0.0.1:55432 (5432 is often Splunk 10's own internal PostgreSQL: never point at that;
# 5433-5435 are often taken by local proxies). Inside docker-compose the engine uses
# DATABASE_URL with host "postgres" instead.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# --- Web UI ---

# Optional. Host port for the web UI (bound to 127.0.0.1). Default 3000.
WEB_PORT=3000
